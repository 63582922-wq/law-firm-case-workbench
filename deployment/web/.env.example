# Copy this file to .env before using Docker Compose.  Every value below is a
# placeholder, not a usable production secret.  Do not commit the resulting .env.

# A DNS name only: no scheme, path, port, user name, or password.
# `localhost` is suitable only for a single-computer smoke check.
LAWCASE_PUBLIC_HOST=localhost

# Bind to loopback by default so a first run is not exposed to the LAN.
# A real firm deployment should use a managed server, an approved DNS name,
# a firewall, and an explicit bind policy rather than blindly setting 0.0.0.0.
LAWCASE_BIND_ADDRESS=127.0.0.1
LAWCASE_HTTP_PORT=8080
LAWCASE_HTTPS_PORT=8443

# Pin base images through the normal security-update process.  Before a real
# deployment, replace tags with organization-approved immutable digests.
LAWCASE_CADDY_IMAGE=caddy:2.11.4-alpine
LAWCASE_NODE_IMAGE=node:22.23.1-bookworm-slim
LAWCASE_PYTHON_IMAGE=python:3.12.13-slim-bookworm
LAWCASE_POSTGRES_IMAGE=postgres:16.14-alpine3.24
LAWCASE_OBJECT_STORE_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
LAWCASE_OBJECT_CLIENT_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z

# Replace both passwords with independent generated values of at least 32
# random characters.  They are deliberately not shared with the browser.
LAWCASE_POSTGRES_DB=lawcase_web
LAWCASE_POSTGRES_USER=lawcase_app
LAWCASE_POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_32_CHARACTER_OR_LONGER_SECRET
LAWCASE_OBJECT_ROOT_USER=lawcase_object_admin
LAWCASE_OBJECT_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_32_CHARACTER_OR_LONGER_SECRET
LAWCASE_OBJECT_BUCKET=lawcase-private

# Keep the first smoke run setup-gated. To enable the real browser API, change
# this to PRODUCTION_WEB and fill every LAWCASE_WEB_* value below with the
# firm's approved OIDC, TLS-verified PostgreSQL, private object-store and
# system-worker settings. The server refuses placeholders and starts no case
# route until all values pass its fail-closed checks.
LAWCASE_WEB_RUNTIME_MODE=SETUP_GATED
LAWCASE_WEB_DEPLOYMENT_TOPOLOGY=SINGLE_API_PROCESS
LAWCASE_WEB_OIDC_STATE_STORE=IN_PROCESS_EPHEMERAL
LAWCASE_WEB_PUBLIC_ORIGIN=https://replace-with-firm-domain.example
LAWCASE_WEB_OIDC_ISSUER=https://replace-with-oidc.example/issuer
LAWCASE_WEB_OIDC_AUTHORIZATION_ENDPOINT=https://replace-with-oidc.example/authorize
LAWCASE_WEB_OIDC_TOKEN_ENDPOINT=https://replace-with-oidc.example/token
LAWCASE_WEB_OIDC_JWKS_URL=https://replace-with-oidc.example/.well-known/jwks.json
LAWCASE_WEB_OIDC_CLIENT_ID=replace-with-client-id
LAWCASE_WEB_OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
LAWCASE_WEB_OIDC_AUDIENCE=replace-with-audience
LAWCASE_WEB_OIDC_SCOPES=openid,profile
LAWCASE_WEB_OIDC_REQUIRED_AMR=mfa
LAWCASE_WEB_OIDC_ACCEPTED_ACR=
# Each DSN must be a separate role/database identity with sslmode=verify-full.
LAWCASE_WEB_APP_POSTGRES_DSN=postgresql://lawcase_web_application:replace@db.example/lawcase?sslmode=verify-full
LAWCASE_WEB_APP_DATABASE_ROLE=lawcase_web_application
LAWCASE_WEB_IDENTITY_DIRECTORY_POSTGRES_DSN=postgresql://lawcase_identity_directory:replace@db.example/lawcase_identity?sslmode=verify-full
LAWCASE_WEB_IDENTITY_DIRECTORY_DATABASE_ROLE=lawcase_identity_directory
LAWCASE_WEB_SESSION_GATEWAY_POSTGRES_DSN=postgresql://lawcase_web_session_gateway:replace@db.example/lawcase_sessions?sslmode=verify-full
LAWCASE_WEB_SESSION_GATEWAY_DATABASE_ROLE=lawcase_web_session_gateway
LAWCASE_WEB_OBJECT_STORE_ENDPOINT=https://replace-with-private-object-store.example
LAWCASE_WEB_OBJECT_STORE_REGION=us-east-1
LAWCASE_WEB_OBJECT_STORE_BUCKET=lawcase-private
LAWCASE_WEB_OBJECT_STORE_ACCESS_KEY_ID=replace-with-object-store-key
LAWCASE_WEB_OBJECT_STORE_SECRET_ACCESS_KEY=REPLACE_WITH_OBJECT_STORE_SECRET
LAWCASE_WEB_OBJECT_STORE_ENCRYPTION=AES256
LAWCASE_WEB_OBJECT_STORE_KMS_KEY_ID=
LAWCASE_WEB_CLAMAV_EXECUTABLE=/usr/bin/clamscan
LAWCASE_WEB_CLAMAV_TIMEOUT_SECONDS=120
LAWCASE_WEB_PDFTOPPM_EXECUTABLE=/usr/bin/pdftoppm
LAWCASE_WEB_PDFTOPPM_TIMEOUT_SECONDS=30
# Optional deterministic Word/Excel review candidates generated from
# confirmed server facts. When true, the browser API calls only the internal
# HMAC-authenticated renderer; it never runs LibreOffice itself.
LAWCASE_WEB_DOCUMENT_WORKER_ENABLED=false
LAWCASE_WEB_DOCUMENT_RENDERER_ENDPOINT=http://document-renderer:8090
LAWCASE_WEB_DOCUMENT_RENDERER_TIMEOUT_SECONDS=180
LAWCASE_WEB_UPLOAD_STAGING_ROOT=/var/lib/lawcase/staging
LAWCASE_WEB_WORKER_MATERIALIZATION_ROOT=/var/lib/lawcase/worker
# JSON object: each firm UUID maps to one separately provisioned SYSTEM_WORKER UUID.
# Keep the value on one line and quote it in shells that interpret braces.
LAWCASE_WEB_SYSTEM_WORKERS_JSON={"00000000-0000-4000-8000-000000000001":"00000000-0000-4000-8000-000000000002"}
# The same firms, each mapped to a different dedicated verifier identity.
LAWCASE_WEB_SYSTEM_VERIFIERS_JSON={"00000000-0000-4000-8000-000000000001":"00000000-0000-4000-8000-000000000003"}

# Independent case-Agent Worker (one deployment instance per firm).  The
# `agent-worker` Compose profile is opt-in and fails closed unless every value
# below is a real production setting. These are server/admin secrets; no
# browser settings page may write or read them.
LAWCASE_AGENT_WORKER_RUNTIME_MODE=PRODUCTION_AGENT_WORKER
LAWCASE_AGENT_WORKER_FIRM_ID=00000000-0000-4000-8000-000000000001
LAWCASE_AGENT_WORKER_ACTOR_ID=00000000-0000-4000-8000-000000000002
LAWCASE_AGENT_WORKER_DATABASE_ROLE=lawcase_agent_worker
LAWCASE_AGENT_WORKER_POSTGRES_DSN=postgresql://lawcase_agent_worker:replace@db.example/lawcase?sslmode=verify-full
# Independent verification uses a second ACTIVE SYSTEM_WORKER and a distinct
# least-privilege database principal. v1 may run in the same container, but it
# reauthorizes and re-reads every candidate rather than trusting execution RAM.
LAWCASE_AGENT_VERIFIER_ACTOR_ID=00000000-0000-4000-8000-000000000003
LAWCASE_AGENT_VERIFIER_DATABASE_ROLE=lawcase_agent_verifier
LAWCASE_AGENT_VERIFIER_POSTGRES_DSN=postgresql://lawcase_agent_verifier:replace@db.example/lawcase?sslmode=verify-full
LAWCASE_AGENT_WORKER_OBJECT_STORE_ENDPOINT=https://replace-with-private-object-store.example
LAWCASE_AGENT_WORKER_OBJECT_STORE_REGION=us-east-1
LAWCASE_AGENT_WORKER_OBJECT_STORE_BUCKET=lawcase-private
LAWCASE_AGENT_WORKER_OBJECT_STORE_ACCESS_KEY_ID=replace-with-agent-object-store-key
LAWCASE_AGENT_WORKER_OBJECT_STORE_SECRET_ACCESS_KEY=REPLACE_WITH_AGENT_OBJECT_STORE_SECRET
LAWCASE_AGENT_WORKER_OBJECT_STORE_ENCRYPTION=AES256
LAWCASE_AGENT_WORKER_OBJECT_STORE_KMS_KEY_ID=
LAWCASE_AGENT_WORKER_DEEPSEEK_API_KEY=REPLACE_WITH_SERVER_DEEPSEEK_KEY
LAWCASE_AGENT_WORKER_DEEPSEEK_MODEL=deepseek-chat
LAWCASE_AGENT_WORKER_DEEPSEEK_ALLOWED_MODELS=deepseek-chat
# Optional fact/transaction extraction is a separate all-or-none credential
# group because its fixed 0045 request/response contract is independent from
# the Planner.  Leave both empty to omit the capability; partial or non-fixed
# values block Worker startup before readiness is published.
LAWCASE_AGENT_WORKER_LEDGER_EXTRACTION_API_KEY=
LAWCASE_AGENT_WORKER_LEDGER_EXTRACTION_MODEL=
# Optional server-admin credential.  When empty, controlled Web search is not
# registered and PDF/Office Agent execution remains available.
LAWCASE_AGENT_WORKER_BRAVE_SEARCH_API_KEY=
# Optional visual OCR is an all-or-none server-admin group.  Leave all three
# empty to keep the capability honestly absent from the Worker catalog.  The
# bundled Worker image installs pdftoppm at /usr/bin/pdftoppm.
LAWCASE_AGENT_WORKER_QWEN_API_KEY=
LAWCASE_AGENT_WORKER_QWEN_WORKSPACE_ID=
LAWCASE_AGENT_WORKER_QWEN_PDFTOPPM_EXECUTABLE=
# Optional whole-case lawyer decision analysis. Both values are server-only
# and all-or-none; the model and one-call/no-retry policy are fixed in code.
LAWCASE_AGENT_WORKER_LAWYER_ANALYSIS_API_KEY=
LAWCASE_AGENT_WORKER_LAWYER_ANALYSIS_WORKSPACE_ID=
# Optional editable Word/Excel plus PDF-preview delivery.  LibreOffice is not
# installed in the provider-egress Agent Worker.  The Worker sends exactly one
# generated DOCX/XLSX byte body to the internal renderer service using a shared
# short-lived HMAC request.  The managed `init` command replaces the renderer
# placeholder with an unpadded base64url secret generated from 48 random bytes.
# Keep it server-side; managed `start` enables both Compose profiles when the
# delivery flag is true.
LAWCASE_AGENT_WORKER_DOCUMENT_DELIVERY_ENABLED=false
# Legacy in-process executable fields remain empty.  They are not a production
# document-delivery configuration.
LAWCASE_AGENT_WORKER_DOCUMENT_SOFFICE_EXECUTABLE=
LAWCASE_AGENT_WORKER_DOCUMENT_PDFTOPPM_EXECUTABLE=
LAWCASE_AGENT_WORKER_DOCUMENT_RENDERER_ENDPOINT=http://document-renderer:8090
# Must stay within 10-180 seconds so the preceding 90-second model exchange,
# rendering and staging fit the immutable 300-second Agent task budget.
LAWCASE_AGENT_WORKER_DOCUMENT_RENDERER_TIMEOUT_SECONDS=180
LAWCASE_DOCUMENT_RENDERER_SHARED_SECRET=REPLACE_WITH_UNPADDED_BASE64URL_OF_AT_LEAST_32_RANDOM_BYTES
LAWCASE_DOCUMENT_RENDERER_TIMEOUT_SECONDS=180
LAWCASE_DOCUMENT_RENDERER_MAX_CLOCK_SKEW_SECONDS=60
LAWCASE_DOCUMENT_RENDERER_REPLAY_CAPACITY=20000

# Local managed Alpha assembly contract.  This template contains no usable
# credentials.  Use scripts/manage_local_managed_test.py init; never copy this
# file to a tracked location with real provider keys.

COMPOSE_PROJECT_NAME=lawcase-managed-alpha
LAWCASE_BIND_ADDRESS=127.0.0.1
LAWCASE_HTTPS_PORT=443
LAWCASE_WORKBENCH_HOST=workbench.127.0.0.1.nip.io
LAWCASE_IDENTITY_HOST=identity.127.0.0.1.nip.io

# Synthetic identities only.  They are stable so the imported OIDC subject and
# PostgreSQL directory seed remain deterministically bound.
LAWCASE_TEST_FIRM_ID=11111111-1111-4111-8111-111111111111
LAWCASE_TEST_LEAD_ACTOR_ID=22222222-2222-4222-8222-222222222222
LAWCASE_TEST_WORKER_ACTOR_ID=33333333-3333-4333-8333-333333333333
LAWCASE_TEST_VERIFIER_ACTOR_ID=44444444-4444-4444-8444-444444444444
LAWCASE_TEST_LEAD_SUBJECT=22222222-2222-4222-8222-222222222222
LAWCASE_TEST_LEAD_USERNAME=lead.lawyer
LAWCASE_TEST_FIRM_NAME=本机受管验收律所

LAWCASE_KEYCLOAK_REALM=lawcase-test
LAWCASE_KEYCLOAK_CLIENT_ID=lawcase-web-workbench
LAWCASE_TEST_OIDC_ISSUER=https://identity.127.0.0.1.nip.io/realms/lawcase-test
LAWCASE_POSTGRES_DB=lawcase
LAWCASE_OBJECT_BUCKET=lawcase-private-alpha
LAWCASE_OBJECT_REGION=us-east-1

# Pinned runtime images.  Production release policy remains separate.
LAWCASE_CADDY_IMAGE=mirror.gcr.io/library/caddy:2.11.4-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
LAWCASE_NODE_IMAGE=mirror.gcr.io/library/node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
LAWCASE_PYTHON_IMAGE=mirror.gcr.io/library/python:3.12.13-slim-bookworm@sha256:4766d8b510c428e595d74b9cc5bbb2fae8e26316fffb4adc89908d79aacd58a2
LAWCASE_POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16.14-alpine3.24@sha256:57c72fd2a128e416c7fcc499958864df5301e940bca0a56f58fddf30ffc07777
LAWCASE_API_IMAGE=lawcase-managed-alpha-api-runtime:local
LAWCASE_MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
LAWCASE_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-08-13T08-35-41Z@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727
LAWCASE_KES_IMAGE=quay.io/minio/kes:2025-03-12T09-35-18Z@sha256:bb97b121b03b0acd04eecea63a5909ec2e56eab1a48e0cc418036b67502a64b0
LAWCASE_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.0@sha256:0f198be292568439d700cdbfb893e69a6009bb43a94a06a945b1d3d506c76b13
LAWCASE_KEYCLOAK_RUNTIME_IMAGE=lawcase-managed-alpha-keycloak:local

# Generated by init.  Every item remains in runtime/local-managed.env (0600).
LAWCASE_POSTGRES_SUPERUSER_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LAWCASE_POSTGRES_MIGRATOR_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LAWCASE_WEB_APP_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LAWCASE_WEB_IDENTITY_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LAWCASE_WEB_SESSION_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LAWCASE_AGENT_WORKER_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LAWCASE_AGENT_VERIFIER_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LAWCASE_KEYCLOAK_POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LAWCASE_KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LAWCASE_TEST_LEAD_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LAWCASE_OIDC_CLIENT_SECRET=REPLACE_WITH_GENERATED_SECRET
LAWCASE_OBJECT_ROOT_USER=lawcase-alpha-root
LAWCASE_OBJECT_ROOT_PASSWORD=REPLACE_WITH_GENERATED_SECRET
LAWCASE_WEB_OBJECT_ACCESS_KEY_ID=REPLACE_WITH_GENERATED_ACCESS_KEY
LAWCASE_WEB_OBJECT_SECRET_ACCESS_KEY=REPLACE_WITH_GENERATED_SECRET
LAWCASE_WORKER_OBJECT_ACCESS_KEY_ID=REPLACE_WITH_GENERATED_ACCESS_KEY
LAWCASE_WORKER_OBJECT_SECRET_ACCESS_KEY=REPLACE_WITH_GENERATED_SECRET
LAWCASE_DOCUMENT_RENDERER_SHARED_SECRET=REPLACE_WITH_GENERATED_BASE64URL_SECRET

# A complete mixed-file test requires real providers.  configure-providers
# writes these without echoing them.  No fake model or offline fallback exists.
LAWCASE_AGENT_WORKER_DEEPSEEK_API_KEY=REPLACE_WITH_REAL_DEEPSEEK_KEY
LAWCASE_AGENT_WORKER_LEDGER_EXTRACTION_API_KEY=REPLACE_WITH_REAL_DEEPSEEK_KEY
LAWCASE_AGENT_WORKER_QWEN_API_KEY=REPLACE_WITH_REAL_QWEN_KEY
LAWCASE_AGENT_WORKER_QWEN_WORKSPACE_ID=REPLACE_WITH_REAL_QWEN_WORKSPACE
LAWCASE_AGENT_WORKER_LAWYER_ANALYSIS_API_KEY=REPLACE_WITH_REAL_QWEN_KEY
LAWCASE_AGENT_WORKER_LAWYER_ANALYSIS_WORKSPACE_ID=REPLACE_WITH_REAL_QWEN_WORKSPACE
# Public search is outside the locked core acceptance path.  Leave empty to
# keep the capability honestly absent; a later administrator may opt in.
LAWCASE_AGENT_WORKER_BRAVE_SEARCH_API_KEY=

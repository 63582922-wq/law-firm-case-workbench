[ req ]
default_bits = 3072
distinguished_name = server_dn
prompt = no
req_extensions = server_extensions

[ server_dn ]
CN = postgres
O = Lawcase Local Managed Test

[ server_extensions ]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature,keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @server_names

[ server_names ]
DNS.1 = postgres
DNS.2 = localhost
IP.1 = 127.0.0.1
IP.2 = ::1


{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "律所案件 AI 工作台",
  "version": "0.1.0",
  "identifier": "cn.lawcase.workbench",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "律所案件 AI 工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["main-local"],
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'none'",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:* http://[::1]:*",
        "font-src": "'self' data:",
        "form-action": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'unsafe-inline' 'self'"
      },
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Business",
    "shortDescription": "证据驱动的律师案件工作台",
    "longDescription": "在律师电脑上受控整理案卷、核验依据、复算金额并编译唯一提交包。",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
